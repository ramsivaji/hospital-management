{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/doctors", "destination": "/index.html" },
    { "source": "/doctors/:id", "destination": "/index.html" },
    { "source": "/showcase", "destination": "/index.html" },
    { "source": "/book/:doctorId", "destination": "/index.html" },
    { "source": "/dashboard/:path*", "destination": "/index.html" }
  ]
}
